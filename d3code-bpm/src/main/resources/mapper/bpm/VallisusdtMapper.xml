<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alphay.boot.bpm.mapper.VallisusdtMapper">

    <resultMap type="com.alphay.boot.bpm.api.domain.Vallisusdt" id="VallisusdtResult">
        <result property="id" column="id"/>
        <result property="openTime" column="open_time"/>
        <result property="open" column="open"/>
        <result property="high" column="high"/>
        <result property="low" column="low"/>
        <result property="close" column="close"/>
        <result property="volume" column="volume"/>
        <result property="closeTime" column="close_time"/>
        <result property="quoteVolume" column="quote_volume"/>
        <result property="trades" column="trades"/>
        <result property="takerBuyBase" column="taker_buy_base"/>
        <result property="takerBuyQuote" column="taker_buy_quote"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVallisusdtVo">
        select id, open_time, open, high, low, close, volume, close_time,
               quote_volume, trades, taker_buy_base, taker_buy_quote,
               create_time, update_time, deleted, create_by, update_by, remark
        from vallisusdt
    </sql>

    <select id="selectVallisusdtList" parameterType="com.alphay.boot.bpm.api.domain.Vallisusdt" resultMap="VallisusdtResult">
        <include refid="selectVallisusdtVo"/>
        <where>
            <if test="openTime != null">
                and open_time = #{openTime}
            </if>
            <if test="deleted != null">
                and deleted = #{deleted}
            </if>
            <if test="deleted == null">
                and deleted = 0
            </if>
        </where>
    </select>

    <resultMap type="com.alphay.boot.bpm.api.domain.PriceChangeStat" id="PriceChangeStatResult">
        <result property="openTime" column="open_time"/>
        <result property="currentClose" column="current_close"/>
        <result property="futureClose" column="future_close"/>
        <result property="changePercent" column="change_percent"/>
        <result property="direction" column="direction"/>
    </resultMap>

    <select id="selectPriceChangeStats" resultMap="PriceChangeStatResult">
        SELECT 
            t1.open_time,
            CAST(t1.close AS DECIMAL(20,2)) AS current_close,
            CAST(t2.close AS DECIMAL(20,2)) AS future_close,
            CASE 
                WHEN CAST(t2.close AS DECIMAL(20,2)) &gt; CAST(t1.close AS DECIMAL(20,2)) THEN 'UP'
                WHEN CAST(t2.close AS DECIMAL(20,2)) &lt; CAST(t1.close AS DECIMAL(20,2)) THEN 'DOWN'
                ELSE 'FLAT' END AS direction,
            ROUND((CAST(t2.close AS DECIMAL(20,2)) - CAST(t1.close AS DECIMAL(20,2))) / NULLIF(CAST(t1.close AS DECIMAL(20,2)),0) * 100, 4) AS change_percent
        FROM vallisusdt t1
        LEFT JOIN vallisusdt t2 ON t2.open_time = t1.open_time + 600000
        WHERE t1.deleted = 0
        ORDER BY t1.open_time
    </select>

    <!-- ==================== 事件合约回测 ==================== -->

    <resultMap type="com.alphay.boot.bpm.api.domain.KlineFuturePrice" id="KlineFuturePriceResult">
        <result property="openTime"      column="open_time"/>
        <result property="openPrice"     column="open_price"/>
        <result property="highPrice"     column="high_price"/>
        <result property="lowPrice"      column="low_price"/>
        <result property="closePrice"    column="close_price"/>
        <result property="takerBuyRatio" column="taker_buy_ratio"/>
        <result property="volume"        column="volume"/>
    </resultMap>

    <!--
        获取所有K线的 OHLC 价格 + takerBuyRatio + volume（已按时间升序）。
        futureClose 由 Java 层用数组下标索引 O(1) 直接跳转。
    -->
    <select id="selectKlineWithFuturePrice" resultMap="KlineFuturePriceResult">
        SELECT
            open_time,
            CAST(open  AS DECIMAL(20,8)) AS open_price,
            CAST(high  AS DECIMAL(20,8)) AS high_price,
            CAST(low   AS DECIMAL(20,8)) AS low_price,
            CAST(close AS DECIMAL(20,8)) AS close_price,
            CASE WHEN CAST(volume AS DECIMAL(20,8)) &gt; 0
                 THEN CAST(taker_buy_base AS DECIMAL(20,8)) / CAST(volume AS DECIMAL(20,8))
                 ELSE 0
            END AS taker_buy_ratio,
            CAST(volume AS DECIMAL(20,8)) AS volume
        FROM vallisusdt
        WHERE deleted = 0
        ORDER BY open_time ASC
    </select>

</mapper>